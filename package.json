{
  "name": "wordpress-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wordpress-harness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/cli.js",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
