{
  "name": "wordpress-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wordpress-harness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node scripts/check-build-output.mjs",
    "build:verify": "node scripts/check-build-output.mjs",
    "cli": "node dist/cli.js",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
